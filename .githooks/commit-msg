#!/usr/bin/env python3
"""Quita el trailer de coautor de Command Code de los mensajes de commit."""
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    lines = handle.read().splitlines()

lines = [
    line
    for line in lines
    if not line.strip().lower().startswith("co-authored-by: commandcodebot")
]
while lines and not lines[-1].strip():
    lines.pop()

with open(path, "w", encoding="utf-8") as handle:
    handle.write("\n".join(lines) + "\n")
